generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String                      @id @default(cuid())
  email         String                      @unique
  name          String?
  role          UserRole                    @default(USER)
  image         String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  emailVerified Boolean                     @default(false)
  accounts      Account[]
  auditLogs     AuditLog[]
  fitReports    FitReport[]
  searchHistories SearchHistory[]
  candidateFeedbacks CandidateFeedback[]
  partVersions  PartVersion[]
  parts         Part[]                      @relation("PartClient")
  requests      Request[]                   @relation("UserRequests")
  projects      ReverseEngineeringProject[]
  sessions      Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  scope                 String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

model Part {
  id                String                      @id @default(cuid())
  partNumber        String                      @unique
  name              String
  description       String?
  status            PartStatus                  @default(DRAFT)
  categoryId        String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  clientId          String?
  ptvReference      String?                     @unique
  searchVector      Unsupported("tsvector")?    @map("search_vector")
  autoCategory      String?
  material          String?
  machineId         String?
  printableModelUrl String?
  attachments       Attachment[]
  fitReports        FitReport[]
  vehicleFitments   Fitment[]
  images            PartImage[]
  specifications    PartSpecification[]
  suppliers         PartSupplier[]
  versions          PartVersion[]
  category          PartCategory?               @relation(fields: [categoryId], references: [id])
  client            User?                       @relation("PartClient", fields: [clientId], references: [id])
  machine           Machine?                    @relation(fields: [machineId], references: [id])
  projects          ReverseEngineeringProject[]

  @@index([partNumber])
  @@index([status])
  @@index([categoryId])
  @@index([clientId])
  @@map("parts")
}

model Vehicle {
  id        String    @id @default(cuid())
  make      String
  model     String
  year      Int
  engine    String?
  /// Identifiant KType+ (standard TecDoc/TecAlliance) — aligné sur le format
  /// KType+ utilisé par les sources aftermarket. Unique si renseigné.
  ktype     String?   @unique
  vin       String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  fitments  Fitment[]

  @@index([make, model, year])
  @@index([ktype])
  @@map("vehicles")
}

model Fitment {
  id        String   @id @default(cuid())
  partId    String
  vehicleId String
  notes     String?
  createdAt DateTime @default(now())
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([partId, vehicleId])
  @@index([partId])
  @@index([vehicleId])
  @@map("fitments")
}

model PartCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      PartCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    PartCategory[] @relation("CategoryHierarchy")
  parts       Part[]

  @@map("part_categories")
}

model PartImage {
  id        String                 @id @default(cuid())
  partId    String
  url       String
  altText   String?
  order     Int                    @default(0)
  createdAt DateTime               @default(now())
  caption   String?
  isPrimary Boolean                @default(false)
  publicId  String?
  embedding Unsupported("vector")? @map("embedding")
  part      Part                   @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@map("part_images")
}

model PartSpecification {
  id           String   @id @default(cuid())
  partId       String
  key          String
  value        String
  unit         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  toleranceMax Float?
  toleranceMin Float?
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, key])
  @@map("part_specifications")
}

model ReverseEngineeringProject {
  id          String                   @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus            @default(DRAFT)
  partId      String?
  userId      String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  cadFiles    CadFile[]
  part        Part?                    @relation(fields: [partId], references: [id])
  user        User?                    @relation(fields: [userId], references: [id])
  steps       ReverseEngineeringStep[]
  requests    Request[]                @relation("RequestToReverseEngineeringProject")

  @@index([status])
  @@index([partId])
  @@index([userId])
  @@map("reverse_engineering_projects")
}

model ReverseEngineeringStep {
  id          String                    @id @default(cuid())
  projectId   String
  name        String
  description String?
  order       Int
  completed   Boolean                   @default(false)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  project     ReverseEngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("reverse_engineering_steps")
}

model CadFile {
  id        String                    @id @default(cuid())
  projectId String
  name      String
  url       String
  fileType  FileType
  sizeBytes Int?
  createdAt DateTime                  @default(now())
  project   ReverseEngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("cad_files")
}

model Supplier {
  id        String         @id @default(cuid())
  name      String
  code      String         @unique
  email     String?
  phone     String?
  website   String?
  address   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parts     PartSupplier[]

  @@map("suppliers")
}

model PartSupplier {
  id           String   @id @default(cuid())
  partId       String
  supplierId   String
  supplierRef  String?
  price        Decimal? @db.Decimal(10, 2)
  currency     String   @default("EUR")
  leadTimeDays Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([partId, supplierId])
  @@index([partId])
  @@index([supplierId])
  @@map("part_suppliers")
}

model Attachment {
  id        String         @id @default(cuid())
  partId    String?
  name      String
  url       String
  fileType  FileType
  sizeBytes Int?
  createdAt DateTime       @default(now())
  kind      AttachmentKind @default(DOCUMENT)
  mimeType  String
  publicId  String?
  part      Part?          @relation(fields: [partId], references: [id])

  @@index([partId])
  @@map("attachments")
}

model AuditLog {
  id           String        @id @default(cuid())
  userId       String?
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime      @default(now())
  user         User?         @relation(fields: [userId], references: [id])
  partVersions PartVersion[]

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PartVersion {
  id            String    @id @default(cuid())
  partId        String
  versionNumber Int
  snapshot      Json
  auditLogId    String?
  createdById   String?
  createdAt     DateTime  @default(now())
  auditLog      AuditLog? @relation(fields: [auditLogId], references: [id])
  createdBy     User?     @relation(fields: [createdById], references: [id])
  part          Part      @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, versionNumber])
  @@index([partId])
  @@map("part_versions")
}

model Request {
  id                String                      @id @default(cuid())
  clientId          String?
  machineRef        String?
  partDescription   String
  partFunction      String?
  suspectedMaterial String?
  quantity          Int                         @default(1)
  urgency           UrgencyLevel                @default(MEDIUM)
  status            RequestStatus               @default(PENDING)
  photos            Json?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  client            User?                       @relation("UserRequests", fields: [clientId], references: [id])
  projects          ReverseEngineeringProject[] @relation("RequestToReverseEngineeringProject")

  @@index([status])
  @@index([clientId])
  @@index([urgency])
  @@map("requests")
}

model Machine {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      MachineType
  status    MachineStatus @default(IDLE)
  location  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parts     Part[]

  @@index([status])
  @@map("machines")
}

model Material {
  id                  String           @id @default(cuid())
  slug                String           @unique
  code                String           @unique
  name                String
  category            MaterialCategory
  density             Float?
  maxTemp             Int?
  tensileStrength     Int?
  hardness            String?
  frictionCoefficient Float?
  resistanceChemical  String?
  foodGrade           Boolean          @default(false)
  description         String?
  advantages          String[]
  commonApplications  String[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([category])
  @@map("materials")
}

model SearchCandidate {
  id                 String   @id @default(cuid())
  source             String
  reference          String
  name               String
  manufacturer       String?
  imageUrl           String?
  cadAvailable       Boolean  @default(false)
  datasheetAvailable Boolean  @default(false)
  scores             Json
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([source])
  @@index([reference])
  @@index([createdAt])
  @@map("search_candidates")
}

model ScoringWeights {
  id         String   @id @default(cuid())
  name       String   @unique @default("default")
  text       Float    @default(0.2)
  reference  Float    @default(0.2)
  specs      Float    @default(0.2)
  dimensions Float    @default(0.2)
  photo      Float    @default(0.2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("scoring_weights")
}

model FitReport {
  id        String   @id @default(cuid())
  partId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([userId])
  @@map("fit_reports")
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String
  query        String
  filters      Json?
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("search_histories")
}

model CandidateFeedback {
  id          String   @id @default(cuid())
  candidateId String
  userId      String
  rating      Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
  @@map("candidate_feedbacks")
}

model DesktopBuild {
  id          String   @id @default(cuid())
  version     String
  os          String
  arch        String   @default("x86_64")
  format      String
  filename    String
  sizeBytes   Int      @map("size_bytes")
  downloadUrl String   @map("download_url")
  checksum    String?
  notes       String?
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([version])
  @@index([publishedAt])
  @@map("desktop_builds")
}

model DesktopInstaller {
  id        String   @id @default(cuid())
  version   String
  os        String
  fileType  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime @default(now())
  isLatest  Boolean  @default(false)

  @@map("desktop_installers")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum PartStatus {
  DRAFT
  SUBMITTED
  ON_HOLD
  IDENTIFYING
  IDENTIFIED
  MEASURING
  READY
  ORDERED
  DELIVERED
  ARCHIVED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum FileType {
  IMAGE
  PDF
  CAD_STL
  CAD_STEP
  CAD_OBJ
  OTHER
}

enum AttachmentKind {
  DOCUMENT
  CAD
  SCAN
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  PENDING
  REVIEW
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum MachineStatus {
  IDLE
  RUNNING
  MAINTENANCE
  OFFLINE
}

enum MachineType {
  CNC
  LATHE
  PRINTER_3D
}

enum MaterialCategory {
  THERMOSTABLE_TECHNIQUE
  THERMOPLASTIQUE_RENFORCE
  POLYMERE_TECHNIQUE_POINT
  FLUOROPOLYMERE_HAUTE_TEMP
  POLYOLEFINE_POLYVALENTE
}
