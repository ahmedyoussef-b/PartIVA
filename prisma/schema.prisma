generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String                      @id @default(cuid())
  email     String                      @unique
  name      String?
  role      UserRole                    @default(USER)
  image     String?
  emailVerified Boolean @default(false)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  accounts  Account[]
  auditLogs AuditLog[]
  requests  Request[]                   @relation("UserRequests")
  projects  ReverseEngineeringProject[]
  sessions  Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

model Part {
  id             String                      @id @default(cuid())
  partNumber     String                      @unique
  name           String
  description    String?
  status         PartStatus                  @default(DRAFT)
  categoryId     String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  attachments    Attachment[]
  images         PartImage[]
  specifications PartSpecification[]
  suppliers      PartSupplier[]
  category       PartCategory?               @relation(fields: [categoryId], references: [id])
  projects       ReverseEngineeringProject[]

  @@index([partNumber])
  @@index([status])
  @@index([categoryId])
  @@map("parts")
}

model PartCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      PartCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    PartCategory[] @relation("CategoryHierarchy")
  parts       Part[]

  @@map("part_categories")
}

model PartImage {
  id        String   @id @default(cuid())
  partId    String
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@map("part_images")
}

model PartSpecification {
  id        String   @id @default(cuid())
  partId    String
  key       String
  value     String
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, key])
  @@map("part_specifications")
}

model ReverseEngineeringProject {
  id          String                   @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus            @default(DRAFT)
  partId      String?
  userId      String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  cadFiles    CadFile[]
  part        Part?                    @relation(fields: [partId], references: [id])
  user        User?                    @relation(fields: [userId], references: [id])
  steps       ReverseEngineeringStep[]
  requests    Request[]                @relation("RequestToReverseEngineeringProject")

  @@index([status])
  @@index([partId])
  @@index([userId])
  @@map("reverse_engineering_projects")
}

model ReverseEngineeringStep {
  id          String                    @id @default(cuid())
  projectId   String
  name        String
  description String?
  order       Int
  completed   Boolean                   @default(false)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  project     ReverseEngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("reverse_engineering_steps")
}

model CadFile {
  id        String                    @id @default(cuid())
  projectId String
  name      String
  url       String
  fileType  FileType
  sizeBytes Int?
  createdAt DateTime                  @default(now())
  project   ReverseEngineeringProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("cad_files")
}

model Supplier {
  id        String         @id @default(cuid())
  name      String
  code      String         @unique
  email     String?
  phone     String?
  website   String?
  address   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parts     PartSupplier[]

  @@map("suppliers")
}

model PartSupplier {
  id           String   @id @default(cuid())
  partId       String
  supplierId   String
  supplierRef  String?
  price        Decimal? @db.Decimal(10, 2)
  currency     String   @default("EUR")
  leadTimeDays Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([partId, supplierId])
  @@index([partId])
  @@index([supplierId])
  @@map("part_suppliers")
}

model Attachment {
  id        String   @id @default(cuid())
  partId    String?
  name      String
  url       String
  fileType  FileType
  sizeBytes Int?
  createdAt DateTime @default(now())
  part      Part?    @relation(fields: [partId], references: [id])

  @@index([partId])
  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Request {
  id                String                      @id @default(cuid())
  clientId          String?
  machineRef        String?
  partDescription   String
  partFunction      String?
  suspectedMaterial String?
  quantity          Int                         @default(1)
  urgency           UrgencyLevel                @default(MEDIUM)
  status            RequestStatus               @default(PENDING)
  photos            Json?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  client            User?                       @relation("UserRequests", fields: [clientId], references: [id])
  projects          ReverseEngineeringProject[] @relation("RequestToReverseEngineeringProject")

  @@index([status])
  @@index([clientId])
  @@index([urgency])
  @@map("requests")
}

model Machine {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      String
  status    MachineStatus @default(IDLE)
  location  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@map("machines")
}

model Material {
  id                  String   @id @default(cuid())
  slug                String   @unique
  code                String   @unique
  name                String
  category            String
  density             Float?
  maxTemp             Int?
  tensileStrength     Int?
  hardness            String?
  frictionCoefficient Float?
  resistanceChemical  String?
  foodGrade           Boolean  @default(false)
  description         String?
  advantages          String[]
  commonApplications  String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([category])
  @@map("materials")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum PartStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DEPRECATED
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum FileType {
  IMAGE
  PDF
  CAD_STL
  CAD_STEP
  CAD_OBJ
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  PENDING
  REVIEW
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum MachineStatus {
  IDLE
  RUNNING
  MAINTENANCE
  OFFLINE
}
