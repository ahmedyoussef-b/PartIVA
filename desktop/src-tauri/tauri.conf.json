{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PartIVA Desktop",
  "version": "0.1.0",
  "identifier": "com.partiva.desktop",
"build": {
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "data:text/html,<html><head><style>body{font-family:system-ui;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:%230f172a;color:white}</style></head><body><div style='text-align:center'><h1>PartIVA Desktop</h1><p>Chargement...</p></div></body></html>",
        "width": 400,
        "height": 300,
        "decorations": false,
        "center": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "PartIVA Desktop",
        "url": "about:blank",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: http://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:* https://res.cloudinary.com;"
    }
  },
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "externalBin": ["node"],
      "resources": ["../server/**/*"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "publisher": "PartIVA",
      "copyright": "© 2026 PartIVA",
      "category": "Business",
      "shortDescription": "PartIVA Desktop — catalogue pièces industrielles",
      "longDescription": "Application desktop PartIVA avec BDD locale synchronisée depuis le cloud. Fonctionne hors ligne après le premier sync.",
      "windows": {
        "webviewInstallMode": {
          "type": "downloadBootstrapper"
        },
        "nsis": {
          "installMode": "currentUser",
          "languages": ["French", "English"],
          "displayLanguageSelector": false
        }
      }
    }
}

