{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PartIVA Desktop",
  "version": "0.1.0",
  "identifier": "com.partiva.desktop",
  "build": {
    "frontendDist": "../ui/out",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "PartIVA Desktop",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "PartIVA",
    "copyright": "© 2026 PartIVA",
    "category": "Business",
    "shortDescription": "PartIVA Desktop — catalogue pièces industrielles",
    "longDescription": "Application desktop PartIVA avec BDD locale synchronisée depuis le cloud. Fonctionne hors ligne après le premier sync.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
