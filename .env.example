# ==========================================
# NEON & DATABASE CONFIGURATION (Template)
# ==========================================

# Clé API Neon pour les commandes CLI (https://console.neon.tech/app/settings/api-keys)
NEON_API_KEY=""

# Identifiant du projet Neon
NEON_PROJECT_ID="spring-tooth-86468642"

# Chaîne de connexion PostgreSQL
# uselibpqcompat=true : préserve le comportement libpq historique de sslmode
# (require/verify-ca/prefer) et supprime le warning SECURITY WARNING de
# pg-connection-string@2.14+ qui traite ces modes comme des alias de
# verify-full. Sans uselibpqcompat, sslmode=require est interprété comme
# verify-full (vérification complète du certificat). Avec uselibpqcompat,
# sslmode=require conserve la sémantique libpq (chiffrement sans
# vérification stricte du certificat). Non-major, sans impact sur les
# vulnérabilités (D64).
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://user:password@endpoint.region.neon.tech/neondb?sslmode=require&uselibpqcompat=true"

# ==========================================
# CLOUDINARY CONFIGURATION (Template)
# ==========================================
# Cloud name — peut être exposé côté client (non secret :
# visible dans les URLs Cloudinary publiques). Utilisé
# côté serveur uniquement dans ce projet (src/lib/cloudinary.ts).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Clés secrètes — SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC_
# (sécurité #7 : aucune clé API côté client).
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=development

# ─── BETTER AUTH (Production Vercel) ───────────────────────────
# Requis en production pour valider l'origine et générer les cookies __Secure-.
# À définir sur le dashboard Vercel (Settings → Environment Variables).
BETTER_AUTH_URL=https://part-iva.vercel.app
BETTER_AUTH_SECRET=<votre_secret_32_chars_minimum>

# ==========================================
# EMBEDDINGS (3 providers supportés — E7-S02-ter)
# ==========================================
# Le code (src/lib/embeddings.ts) détecte le provider
# automatiquement via HF_API_URL. CLIP (image → 768 dims)
# est requis pour la recherche visuelle (pgvector).
#
# Provider 1 : Lightweight Embeddings (self-host local, 100% gratuit)
#   - Cloner : git clone https://huggingface.co/spaces/lamhieu/lightweight-embeddings
#   - Lancer : docker compose up -d
#   - Config : HF_API_URL=http://localhost:8000/v1/embeddings
#   - Token  : aucun (laisser vide)
#
# Provider 2 : DeepInfra (payant, ~$0.005/1M tokens)
#   - Config : HF_API_URL=https://api.deepinfra.com/v1/inference
#   - Token  : https://deepinfra.com/dash/api_keys
#
# Provider 3 : HuggingFace hf-inference (gratuit, CLIP non supporté)
#   - Config : HF_API_URL=https://router.huggingface.co/hf-inference/models
#   - Token  : https://huggingface.co/settings/tokens
#
# Sécurité #7 : HF_API_TOKEN jamais en NEXT_PUBLIC_.
# R.5.10 : variable vide = absente.
HF_API_URL=http://localhost:8000/v1/embeddings
HF_API_TOKEN=""
HF_EMBEDDING_MODEL=siglip-base-patch16-256-multilingual

# ── E3 Sources externes ──

# TraceParts (MVP E3-S02 — obligatoire)
# Bearer JWT généré à la volée via RequestToken (valide 24h).
# Absent = mode mock activé automatiquement.
TRACEPARTS_TENANT_UID=""
TRACEPARTS_API_KEY=""

# Wikidata (MVP E3-S03 — SPARQL public)
# User-Agent obligatoire (politique Wikimedia) — sinon HTTP 403.
# Pas de credentials requis (endpoint public).
WIKIDATA_USER_AGENT="PartIVA/1.0 (https://partiva.example; contact@partiva.example)"

# ── E5 Déploiement ─────────────────────────────────────
# Mode placeholder (E5-S02) — 'true' bloque les zones
# fonctionnelles (recherche, admin, client, API métier)
# et redirige vers /placeholder, tout en laissant la
# vitrine publique (/, /services, /contact, /materiaux,
# /demande, /login, /register) et /api/health accessibles.
# Booléen de feature flag — jamais un secret (sécurité #7).
# 'false' en développement et quand l'app est complète.
NEXT_PUBLIC_PLACEHOLDER_MODE=false

# ==========================================
# ADMIN (seed production)
# ==========================================
# Si définis, un admin réel est créé au seed (upsert).
# Sinon, les utilisateurs mock sont utilisés (dev uniquement).
# Sécurité #7 : jamais en NEXT_PUBLIC_.
# R.5.10 : variable vide = absente.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin PartIVA"
