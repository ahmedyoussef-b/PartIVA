# ==========================================
# NEON & DATABASE CONFIGURATION (Template)
# ==========================================

# Clé API Neon pour les commandes CLI (https://console.neon.tech/app/settings/api-keys)
NEON_API_KEY=""

# Identifiant du projet Neon
NEON_PROJECT_ID="spring-tooth-86468642"

# Chaîne de connexion PostgreSQL
# uselibpqcompat=true : préserve le comportement libpq historique de sslmode
# (require/verify-ca/prefer) et supprime le warning SECURITY WARNING de
# pg-connection-string@2.14+ qui traite ces modes comme des alias de
# verify-full. Sans uselibpqcompat, sslmode=require est interprété comme
# verify-full (vérification complète du certificat). Avec uselibpqcompat,
# sslmode=require conserve la sémantique libpq (chiffrement sans
# vérification stricte du certificat). Non-major, sans impact sur les
# vulnérabilités (D64).
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://user:password@endpoint.region.neon.tech/neondb?sslmode=require&uselibpqcompat=true"

# ==========================================
# CLOUDINARY CONFIGURATION (Template)
# ==========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=development
